{
  "name": "exponential-mcp",
  "version": "0.14.0",
  "description": "MCP server for Exponential - connect Claude to your projects, actions, goals, CRM, tickets and more",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tools": {
      "types": "./dist/tools.d.ts",
      "default": "./dist/tools.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "exponential-mcp": "./dist/cli.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "cli": "node dist/cli.js",
    "prepublishOnly": "npm run build",
    "test": "tsc && node --test test/*.test.mjs"
  },
  "keywords": [
    "mcp",
    "claude",
    "exponential",
    "productivity",
    "anthropic"
  ],
  "author": "Exponential",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/exponential-im/exponential-mcp.git"
  },
  "homepage": "https://github.com/exponential-im/exponential-mcp#readme",
  "bugs": {
    "url": "https://github.com/exponential-im/exponential-mcp/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "commander": "^12.0.0",
    "exponential-sdk": "^1.32.0",
    "zod": "^3.22.0",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist"
  ]
}
